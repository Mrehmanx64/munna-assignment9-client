# ==============================================================================
# RENTORA EQUIPMENT RENTAL PLATFORM — CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Note: Next.js exposes environment variables to the browser only when prefixed
# with NEXT_PUBLIC_. Never put secret keys or private credentials in this file.
# ==============================================================================

# Application Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Express API Endpoint (e.g. http://localhost:5000/api in development, https://rentora-api.onrender.com/api in production)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth Public Client ID (optional, for client-side Google sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

# Stripe Publishable Key (for client-side Stripe checkout and Payment Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
